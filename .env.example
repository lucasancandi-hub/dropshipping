# Numero WhatsApp in formato internazionale, solo cifre (senza + e senza spazi)
NEXT_PUBLIC_WHATSAPP_PHONE=393408857026

# Nome mostrato in header, titolo e messaggio
NEXT_PUBLIC_SHOP_NAME=Atelier

# --- Spedizione stimata ---------------------------------------------------
# flat | quantity | none
NEXT_PUBLIC_SHIPPING_MODE=flat
NEXT_PUBLIC_SHIPPING_FLAT=7.90
NEXT_PUBLIC_SHIPPING_BASE=0
NEXT_PUBLIC_SHIPPING_PER_ITEM=2.00
NEXT_PUBLIC_SHIPPING_FREE_OVER=99

# --- Numerazione ordini ---------------------------------------------------
NEXT_PUBLIC_ORDER_PREFIX=ORD
NEXT_PUBLIC_ORDER_DIGITS=3

# Opzionale: numerazione ordini condivisa fra tutti i visitatori.
# Senza queste due variabili il contatore resta locale al browser.
# Si ottengono creando uno store Redis/KV dalla dashboard Vercel.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
